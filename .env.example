# Copy to .env for local development. Never commit real credentials.
POSTGRES_DB=developer_intelligence
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://app:change-me-local-only@postgres:5432/developer_intelligence
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=1048576
MAX_REPOSITORY_FILES=10000
MAX_REPOSITORY_BYTES=104857600
# Leave empty until a provider is intentionally configured.
OPENAI_API_KEY=
GITHUB_TOKEN=
